<Window x:Class="Wobbi.AgendaEventDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Details 💜"
        Width="500"
        Height="560"
        MinWidth="500"
        MinHeight="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#191526"
        Foreground="#F8F5FF"
        Topmost="False"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="DetailButton"
               TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="15,8"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Opacity"
                                        Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="46"
                    Height="46"
                    Background="#433158"
                    CornerRadius="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <TextBlock Text="♥"
                           Foreground="#D8B6FF"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="2,0,0,0">
                <TextBlock Text="Event details"
                           FontSize="21"
                           FontWeight="Bold"/>

                <TextBlock Text="Your little personal planner"
                           Foreground="#A99BBB"
                           FontSize="12"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <!-- APPOINTMENT CARD -->
        <Border Grid.Row="1"
                Background="#292238"
                BorderBrush="#473755"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18"
                Margin="0,0,0,22">

            <StackPanel>
                <TextBlock Text="APPOINTMENT"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#BD94FB"
                           Margin="0,0,0,9"/>

                <TextBlock x:Name="EventTitleText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <Border Background="#342A45"
                        CornerRadius="10"
                        Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="◷"
                                   FontSize="18"
                                   Foreground="#C39EF5"
                                   VerticalAlignment="Top"/>

                        <TextBlock x:Name="EventTimeText"
                                   Grid.Column="1"
                                   Foreground="#EADCF9"
                                   FontSize="12"
                                   LineHeight="22"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- DESCRIPTION TITLE -->
        <TextBlock Grid.Row="2"
                   Text="Description"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,10"/>

        <!-- DESCRIPTION CARD -->
        <Border Grid.Row="3"
                Background="#241D33"
                BorderBrush="#40334F"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,18">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          BorderThickness="0"
                          Background="Transparent"
                          Padding="0">
                <TextBlock x:Name="EventDescriptionText"
                           Text="No description added."
                           Foreground="#C7BDD9"
                           FontSize="13"
                           LineHeight="21"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- BUTTONS -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#40334F"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">

                <Button Content="Close"
                        Width="95"
                        Margin="0,0,8,0"
                        Background="#30283F"
                        Style="{StaticResource DetailButton}"
                        IsCancel="True"
                        Click="Close_Click"/>

                <Button Content="✎ Edit"
                        Width="110"
                        Margin="0,0,8,0"
                        Background="#9876DB"
                        Style="{StaticResource DetailButton}"
                        Click="Edit_Click"/>

                <Button Content="✕ Delete"
                        Width="110"
                        Background="#704455"
                        Style="{StaticResource DetailButton}"
                        Click="Delete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
