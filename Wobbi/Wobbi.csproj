<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<ApplicationIcon>Assets\Wobbi.ico</ApplicationIcon>
	  
<Version>0.5.0</Version>

  </PropertyGroup>


	<ItemGroup>
		<None Remove="Assets\Cursors\*.cur" />
		<Content Include="Assets\Cursors\*.cur" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>


	<ItemGroup>
    <None Remove="Assets\Cosmic\wobbi.png" />
    <None Remove="Assets\Mini\mini-idle.png" />
	  <None Remove="Assets\Mini\mini-blink.png" />

	  <None Remove="Assets\Mini\mini-look-left.png" />
	  <None Remove="Assets\Mini\mini-look-right.png" />

	  <None Remove="Assets\wobbi-blink.svg" />
    <None Remove="Assets\wobbi.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dota2GSI" Version="2.1.1.8897" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
  </ItemGroup>

  <ItemGroup>

	  <None Remove="Assets\Cosmic\wobbi-blink.png" />

	  <None Remove="Assets\Cosmic\wobbi-happy.png" />

	  <Resource Include="Assets\Cosmic\wobbi-happy.png" />

	  <None Remove="Assets\Cosmic\wobbi-scritch.png" />
	  <Resource Include="Assets\Cosmic\wobbi-scritch.png" />

	  <Resource Include="Assets\Cosmic\wobbi-blink.png" />
	  <Resource Include="Assets\Cosmic\wobbi.png">
	  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	</Resource>
	<Resource Include="Assets\Lavender\wobbi-scritch.svg" />
	<Resource Include="Assets\Mini\mini-idle.png">
	  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	</Resource>

	  <Resource Include="Assets\Mini\mini-blink.png">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>

	  <Resource Include="Assets\Mini\mini-look-left.png" />
	  <Resource Include="Assets\Mini\mini-look-right.png" />
	  <Resource Include="Assets\wobbi-sleep.svg" />

	  <Resource Include="Assets\Wobbi.ico" />
    <Resource Include="Assets\wobbi-happy.svg" />
    <Resource Include="Assets\wobbi-scritch.svg" />
    <Resource Include="Assets\wobbi-blink.svg" />
    <Resource Include="Assets\wobbi.svg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
	  <Resource Include="Assets\Lavender\wobbi.svg" />
	  <Resource Include="Assets\Lavender\wobbi-blink.svg" />
	  <Resource Include="Assets\Lavender\wobbi-sleep.svg" />
	  <Resource Include="Assets\Lavender\wobbi-happy.svg" />
	  <Resource Include="Assets\Wobbi-Mini.png" />
  </ItemGroup>

</Project>
