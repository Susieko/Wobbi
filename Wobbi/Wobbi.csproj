<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\wobbi-blink.svg" />
    <None Remove="Assets\wobbi.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\wobbi-happy.svg" />
    <Resource Include="Assets\wobbi-sleep.svg" />
    <Resource Include="Assets\wobbi-blink.svg" />
    <Resource Include="Assets\wobbi.svg" />
  </ItemGroup>

</Project>
