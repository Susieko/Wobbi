<Window x:Class="Wobbi.ReminderToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="350"
        Height="115"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False">

    <Border Background="#251D35"
            BorderBrush="#7655A4"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="36"
                    Height="36"
                    Background="#493563"
                    CornerRadius="10"
                    VerticalAlignment="Top">

                <TextBlock Text="♥"
                           FontSize="22"
                           Foreground="#E3C5FF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="8,0,0,0">

                <TextBlock Text="Wobbi reminder 💜"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"/>

                <TextBlock x:Name="ReminderText"
                           Foreground="#D5C4EB"
                           FontSize="12"
                           Margin="0,7,0,0"
                           TextWrapping="Wrap"
                           MaxHeight="47"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>
