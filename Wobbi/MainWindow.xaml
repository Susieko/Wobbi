<Window x:Class="Wobbi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="Wobbi"
        Width="300"
        Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Background="Transparent">

        <!-- Wobbi's right-click menu -->
        <Grid.ContextMenu>
            <ContextMenu>

                <MenuItem Header="Talk to Wobbi 💬"
                          Click="OpenChat_Click"/>

                <MenuItem Header="Pet Wobbi 💜"
                          Click="PetWobbi_Click"/>

                <Separator/>

                <MenuItem Header="Quit Wobbi"
                          Click="Exit_Click"/>

            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Wobbi's animated character -->
        <Grid x:Name="WobbiImage"
              Margin="10">

            <!-- Normal Wobbi -->
            <svgc:SvgViewbox
                x:Name="OpenEyes"
                Source="pack://application:,,,/Assets/wobbi.svg"
                Stretch="Uniform"/>

            <!-- Blinking Wobbi -->
            <svgc:SvgViewbox
                x:Name="ClosedEyes"
                Source="pack://application:,,,/Assets/wobbi-blink.svg"
                Stretch="Uniform"
                Visibility="Collapsed"/>

            <!-- Sleeping Wobbi -->
            <svgc:SvgViewbox
                x:Name="SleepEyes"
                Source="pack://application:,,,/Assets/wobbi-sleep.svg"
                Stretch="Uniform"
                Visibility="Collapsed"/>
            <!-- Happy Wobbi -->
            <svgc:SvgViewbox
                 x:Name="HappyEyes"
                 Source="pack://application:,,,/Assets/wobbi-happy.svg"
                 Stretch="Uniform"
                 Visibility="Collapsed"/>


            <!-- Animated sleeping particles -->
            <Viewbox x:Name="SleepParticles"
         Stretch="Uniform"
         Visibility="Collapsed"
         IsHitTestVisible="False">

                <Canvas Width="930" Height="700">

                    <TextBlock x:Name="SleepZ1"
                   Text="z"
                   FontSize="29"
                   FontWeight="Bold"
                   Foreground="#B59CEB"
                   Canvas.Left="558"
                   Canvas.Top="220"
                   Opacity="0"/>

                    <TextBlock x:Name="SleepZ2"
                   Text="z"
                   FontSize="36"
                   FontWeight="Bold"
                   Foreground="#C9AFF5"
                   Canvas.Left="583"
                   Canvas.Top="188"
                   Opacity="0"/>

                    <TextBlock x:Name="SleepZ3"
                   Text="Z"
                   FontSize="43"
                   FontWeight="Bold"
                   Foreground="#E0CEFF"
                   Canvas.Left="610"
                   Canvas.Top="155"
                   Opacity="0"/>

                </Canvas>
            </Viewbox>
            <!-- Floating love hearts -->
            <Viewbox x:Name="HeartParticles"
              Stretch="Uniform"
              Visibility="Collapsed"
              IsHitTestVisible="False">

                <Canvas Width="930" Height="700">

                    <TextBlock x:Name="Heart1"
                   Text="❤"
                   FontSize="34"
                   FontWeight="Bold"
                   Foreground="#FF8FC7"
                   Canvas.Left="330"
                   Canvas.Top="235"
                   Opacity="0"/>

                    <TextBlock x:Name="Heart2"
                   Text="❤"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#FFB2DA"
                   Canvas.Left="385"
                   Canvas.Top="210"
                   Opacity="0"/>

                    <TextBlock x:Name="Heart3"
                   Text="❤"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#FFD0E9"
                   Canvas.Left="442"
                   Canvas.Top="238"
                   Opacity="0"/>
                </Canvas>
            </Viewbox>

        </Grid>


        <!-- Wobbi's little speech bubble -->
        <StackPanel x:Name="SpeechBubble"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Panel.ZIndex="50"
            Opacity="0"
            Visibility="Collapsed"
            IsHitTestVisible="False">

            <Border Background="#F1E6FF"
            BorderBrush="#BDA4E8"
            BorderThickness="1"
            CornerRadius="16"
            Padding="13,10"
            MaxWidth="255">

                <StackPanel>

                    <TextBlock Text="✦ Wobbi"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#8564B3"
                       Margin="0,0,0,5"/>

                    <TextBlock x:Name="SpeechBubbleText"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="220"
                       MaxHeight="65"
                       FontSize="13"
                       Foreground="#30254A"/>

                </StackPanel>

            </Border>

            <!-- Little pointed speech-bubble tail -->
            <Path Data="M 0 0 L 18 0 L 9 11 Z"
          Fill="#F1E6FF"
          HorizontalAlignment="Center"/>

        </StackPanel>

    </Grid>
</Window>
