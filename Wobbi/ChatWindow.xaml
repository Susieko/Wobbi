<Window x:Class="Wobbi.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Talk to Wobbi"
        Width="410"
        Height="480"
        MinWidth="350"
        MinHeight="380"
        WindowStartupLocation="Manual"
        Background="#181729">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel>
            <TextBlock Text="✦ WOBBI"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#D2BBFF"/>

            <TextBlock
                Text="Your little cosmic companion"
                Foreground="#B5AFCF"
                Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Scrollable conversation history -->
        <ScrollViewer x:Name="ChatScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,24,0,24">

            <StackPanel x:Name="MessagesPanel"/>

        </ScrollViewer>

        <!-- Message input -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageInput"
                     Height="42"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     Background="#302C49"
                     Foreground="White"
                     CaretBrush="White"
                     BorderBrush="#544C7E"
                     KeyDown="MessageInput_KeyDown"/>

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send"
                    Padding="18,10"
                    Margin="10,0,0,0"
                    Background="#A08AE8"
                    Foreground="#181729"
                    FontWeight="Bold"
                    Click="Send_Click"/>
        </Grid>
    </Grid>
</Window>

