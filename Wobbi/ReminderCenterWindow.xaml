<Window x:Class="Wobbi.ReminderCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wobbi Reminders 💜"
        Width="410"
        Height="430"
        MinWidth="350"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Topmost="False"
        ShowInTaskbar="True"
        Background="#191526"
        Foreground="#F8F5FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Wobbi Reminders 💜"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock Text="You've got things to remember!"
                       Foreground="#BDB3D4"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Reminders -->
        <Border Grid.Row="1"
                Background="#29233B"
                CornerRadius="12"
                Padding="12">

            <Grid>
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="ReminderList">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#38304D"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,10">

                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontWeight="SemiBold"
                                            FontSize="16"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Text="{Binding StartsAt, StringFormat={}{0:dd-MM-yyyy HH:mm}}"
                                            Foreground="#CCAFFF"
                                            Margin="0,7,0,12"/>

                                        <Button
                                            Content="✓ Dismiss reminder"
                                            Height="36"
                                            Background="#9876DB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="DismissReminder_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyText"
                           Text="All caught up! 💜"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#BDB3D4"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Closing this window won't dismiss reminders."
                   Foreground="#BDB3D4"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
    