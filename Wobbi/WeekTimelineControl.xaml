<UserControl x:Class="Wobbi.WeekTimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#29233B">



    <UserControl.Resources>
        <Style x:Key="CalendarEventStyle"
           TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="EventBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="5"
                            ClipToBounds="True">

                            <Grid>

                                <!-- Colored accent strip -->
                                <Border Width="4"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding BorderBrush}"
                                    IsHitTestVisible="False"/>

                                <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Margin="10,5,5,3"/>

                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Subtle hover outline -->
                            <Trigger Property="IsMouseOver"
                                 Value="True">
                                <Setter TargetName="EventBorder"
                                    Property="BorderBrush"
                                    Value="#DDD2FA"/>
                            </Trigger>

                            <!-- Keyboard focus -->
                            <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                                <Setter TargetName="EventBorder"
                                    Property="BorderBrush"
                                    Value="White"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- WEEKDAY HEADERS -->
        <Grid Grid.Row="0"
      Width="{Binding ElementName=WeekHoursGrid,
                      Path=ActualWidth}"
      HorizontalAlignment="Left">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="TIME"
                       Foreground="#BDB3D4"
                       FontSize="10"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <UniformGrid x:Name="DayHeaders"
                         Grid.Column="1"
                         Columns="7"
                         Rows="1"/>
        </Grid>

        <!-- SCROLLABLE HOURLY TIMELINE -->
        <ScrollViewer x:Name="WeekHoursScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid x:Name="WeekHoursGrid"
                  Background="#1B1726"/>

        </ScrollViewer>
    </Grid>
</UserControl>
